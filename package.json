{
  "name": "malkoto-umniche",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Малкото Умниче — безплатна образователна PWA за деца 2–6 г.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "build:assets": "node scripts/build-assets.mjs && node scripts/check-assets.mjs",
    "build:audio": "node scripts/build-audio.mjs && node scripts/check-audio.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:variants": "tsx scripts/check-variants.ts",
    "check:assets": "node scripts/check-assets.mjs",
    "check:mechanics": "node scripts/check-mechanics.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "check:ages": "node scripts/check-age-fit.mjs && tsx scripts/check-age-progression.ts",
    "check:covers": "tsx scripts/check-covers.ts",
    "check:practical": "tsx scripts/check-practical-games.ts",
    "check:categories": "tsx scripts/check-category-identity.ts",
    "build:mechanics": "node scripts/build-mechanics-index.mjs",
    "check": "npm run typecheck && npm run lint && npm run validate:content && npm run check:variants && npm run check:assets && npm run check:mechanics && npm run check:audio && npm run check:ages && npm run check:covers && npm run check:practical && npm run check:categories"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@twemoji/svg": "^15.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
